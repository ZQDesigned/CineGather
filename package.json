{
  "name": "cinegather",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "typescript": "5.9.3",
      "zod": "4.6.7",
      "livekit-client": "2.23.0",
      "drizzle-orm": "0.45.4",
      "pg": "8.23.1",
      "@nestjs/common": "12.1.3",
      "@nestjs/core": "12.1.3",
      "@nestjs/platform-express": "12.1.3",
      "@nestjs/swagger": "12.0.2"
    }
  },
  "scripts": {
    "setup": "bun tools/setup.ts",
    "infra:up": "docker compose --env-file .env -f infra/compose/dev.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose/dev.yml down",
    "db:migrate": "bun packages/database/src/migrate.ts",
    "dev": "bun tools/dev.ts",
    "dev:api": "bun run --filter @cinegather/api dev",
    "dev:desktop": "bun run --filter @cinegather/desktop dev",
    "dev:renderer": "bun run --filter @cinegather/desktop dev:renderer",
    "dev:web": "bun run --filter @cinegather/desktop dev:web",
    "build:web": "bun run --filter @cinegather/desktop build:web",
    "serve:web": "bun run --filter @cinegather/desktop serve:web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test packages apps/api/test apps/desktop/test",
    "test:integration": "bun test tests/integration",
    "test:e2e": "playwright test",
    "test:web": "bun run build:web && playwright test --config playwright.web.config.ts",
    "build": "bun run --filter @cinegather/api build && bun run --filter @cinegather/desktop build",
    "api:generate": "bun apps/api/src/export-openapi.ts && openapi-typescript docs/api/openapi.json -o packages/api-client/src/schema.ts",
    "dist:win": "bun run --filter @cinegather/desktop dist:win",
    "dist:mac": "bun run --filter @cinegather/desktop dist:mac",
    "check": "bun run typecheck && bun run lint && bun run test",
    "electron:install": "node node_modules/electron/install.js",
    "db:backup": "bun tools/backup.ts",
    "db:restore": "bun tools/restore.ts",
    "git:verify": "bun tools/check-git.ts",
    "test:soak": "bun tools/soak.ts",
    "test:runtime": "bun tools/runtime-check.ts && bun tools/runtime-check.ts node",
    "test:container": "bun tools/container-smoke.ts",
    "release:manifest": "bun tools/release-manifest.ts",
    "format": "prettier --write apps packages tests tools infra .github package.json tsconfig.json tsconfig.base.json eslint.config.mjs playwright.config.ts playwright.web.config.ts --ignore-unknown",
    "format:check": "prettier --check apps packages tests tools infra .github package.json tsconfig.json tsconfig.base.json eslint.config.mjs playwright.config.ts playwright.web.config.ts --ignore-unknown",
    "native:build": "python3 native/capture/build-macos.py",
    "test:native": "bun test native/capture/test",
    "test:native-host": "bun tools/native-host-smoke.ts",
    "icons:build": "bun tools/icons.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.3",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.2"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}

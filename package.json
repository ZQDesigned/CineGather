{
  "name": "cinegather",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "typescript": "5.9.3",
      "zod": "4.6.7",
      "livekit-client": "2.23.0",
      "drizzle-orm": "0.45.4",
      "pg": "8.23.1",
      "@nestjs/common": "12.1.3",
      "@nestjs/core": "12.1.3",
      "@nestjs/platform-express": "12.1.3",
      "@nestjs/swagger": "12.0.2"
    }
  },
  "scripts": {
    "setup": "bun tools/setup.ts",
    "infra:up": "docker compose --env-file .env -f infra/compose/dev.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose/dev.yml down",
    "db:migrate": "bun packages/database/src/migrate.ts",
    "dev": "bun tools/dev.ts",
    "dev:api": "bun run --filter @cinegather/api dev",
    "dev:desktop": "bun run --filter @cinegather/desktop dev",
    "dev:renderer": "bun run --filter @cinegather/desktop dev:renderer",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test packages apps/api/test apps/desktop/test",
    "test:integration": "bun test tests/integration",
    "test:e2e": "playwright test",
    "build": "bun run --filter @cinegather/api build && bun run --filter @cinegather/desktop build",
    "api:generate": "bun apps/api/src/export-openapi.ts && openapi-typescript docs/api/openapi.json -o packages/api-client/src/schema.ts",
    "dist:win": "bun run --filter @cinegather/desktop dist:win",
    "dist:mac": "bun run --filter @cinegather/desktop dist:mac",
    "check": "bun run typecheck && bun run lint && bun run test",
    "electron:install": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.71.2",
    "typescript": "catalog:",
    "@types/bun": "latest",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "@types/express": "5.0.6",
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}

NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=14310
TRUST_PROXY=loopback
CORS_ORIGINS=
DATABASE_URL=postgres://cinegather:REPLACE_RANDOM_HEX@127.0.0.1:5432/cinegather
SESSION_SECRET=REPLACE_AT_LEAST_32_RANDOM_CHARACTERS
LIVEKIT_API_KEY=REPLACE_API_KEY
LIVEKIT_API_SECRET=REPLACE_AT_LEAST_32_RANDOM_CHARACTERS
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_URL=wss://media.example.com

# Initial policy only; superadmin changes are persisted in the database.
REGISTRATION_ENABLED=false

# Minimum compatible client versions. 0.0.0 disables the cutoff for that platform.
# Deploy API/CORS support before desktop clients. Publish compatible installers
# before raising these cutoffs, so users always have a working update path.
CLIENT_MIN_VERSION_WINDOWS=0.0.0
CLIENT_MIN_VERSION_MACOS=0.0.0
CLIENT_MIN_VERSION_WEB=0.0.0
CLIENT_UPDATE_REASON=当前版本已不受支持，请更新映聚后继续使用。

# Optional official CDN origin CIDRs (JSON array); unset means do not trust CDN headers.
TRUSTED_CDN_CIDRS_FILE=
# Optional private-only LiveKit Prometheus endpoint; never proxy it publicly.
LIVEKIT_METRICS_URL=http://127.0.0.1:6789/metrics

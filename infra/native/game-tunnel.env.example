# Generate a dedicated RSA2048+ PKCS8 private key, readable only by the API user.
# Create secret/cert files with mode 0600; these are deployment templates only.
GAME_TUNNEL_KEY_FILE=/etc/cinegather/game/signing.pem
GAME_TUNNEL_HOST=game.cgplat.example.invalid
GAME_TUNNEL_PORT=17443
GAME_TUNNEL_TLS_NAME=game.cgplat.example.invalid
GAME_TUNNEL_ISSUER=https://cgplat.example.invalid/api/v1/game-tunnel/identity
GAME_TUNNEL_PLUGIN_SECRET=REPLACE_WITH_LOCAL_PLUGIN_SECRET_AT_LEAST_32_BYTES
# An independently reachable STUN UDP endpoint with RFC5780 OTHER-ADDRESS support.
# May reuse the platform's TURN/STUN service. No CDN; do not point this at FRPS TCP.
GAME_TUNNEL_STUN_SERVER=turn.cgplat.example.invalid:3478

[Unit]
Description=CineGather game transport relay
After=network-online.target cinegather-api.service
Wants=network-online.target
[Service]
Type=simple
User=cinegather
Group=cinegather
ExecStart=/opt/cinegather/game/frps -c /etc/cinegather/game/frps.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/cinegather
LimitNOFILE=8192
[Install]
WantedBy=multi-user.target

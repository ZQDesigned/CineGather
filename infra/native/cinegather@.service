[Unit]
Description=CineGather %i
Wants=network-online.target
After=network-online.target
Requires=cinegather-network.service
After=cinegather-network.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=cinegather
Group=cinegather
WorkingDirectory=/opt/cinegather/current
EnvironmentFile=/etc/cinegather/service.env
Environment=GOMAXPROCS=2 GOMEMLIMIT=256MiB
ExecStart=/bin/sh /opt/cinegather/current/infra/native/run-service.sh %i
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
UMask=0027
LimitNOFILE=65536
MemoryHigh=512M
MemoryMax=768M
TasksMax=256
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cinegather /var/log/cinegather

[Install]
WantedBy=multi-user.target

POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
LIVEKIT_API_KEY=REPLACE_WITH_PRODUCTION_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
API_DOMAIN=api.example.com
WEB_DOMAIN=watch.example.com
MEDIA_DOMAIN=media.example.com
LIVEKIT_CONFIG_PATH=/etc/cinegather/livekit.yaml
TLS_CERT_DIR=/etc/cinegather/turn-certs
# Include the web origin even for same-origin HTTP: browser activity WebSockets
# enforce this allowlist too. Comma-separate additional trusted web origins.
CORS_ORIGINS=https://app.example.com

REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
WHIP_DOMAIN=whip.example.com
INGRESS_CONFIG_PATH=/etc/cinegather/ingress.yaml
